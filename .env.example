# Copy to .env and fill in what you use.
# Provider is auto-detected: openai (if OPENAI_API_KEY) > anthropic (if ANTHROPIC_API_KEY) > gemini (if GOOGLE_API_KEY) > mock.
# You can force a provider with LLM_PROVIDER=openai|anthropic|gemini|mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional overrides
LLM_PROVIDER=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2
MAX_RED_STEPS=15